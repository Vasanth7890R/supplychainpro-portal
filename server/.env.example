PORT=5000
NODE_ENV=development

# Database configuration
# Set DB_TYPE=mysql to use MySQL, or sqlite to use the local SQLite database.
# If DB_TYPE=mysql and MySQL connection fails, it will gracefully fallback to SQLite.
DB_TYPE=mysql

# MySQL Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=supplychainpro

# JWT Secret for authentication
JWT_SECRET=supplychainpro_jwt_secret_key_super_secure_2026
